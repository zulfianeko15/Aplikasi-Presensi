# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (e.g., https://absensi.sekolah.sch.id).
APP_URL="MY_APP_URL"

# =====================================================================
# KONEKSI DATABASE POSTGRESQL (PILIH SALAH SATU CARA BERIKUT):
# =====================================================================

# CARA 1 (SUPABASE URI - PALING DIREKOMENDASIKAN):
# Dapatkan dari Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"

# CARA 2 (PARAMETER TERPISAH):
# SQL_HOST="db.[PROJECT-REF].supabase.co"
# SQL_PORT="5432"
# SQL_USER="postgres"
# SQL_PASSWORD="MY_SUPABASE_PASSWORD"
# SQL_DB_NAME="postgres"
# SQL_SSL="true"
